---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Related from '../../components/Related.astro';
import { getSiteContent, readingTime } from '../../lib/content';
import { formatDate } from '../../config/site';
import 'katex/dist/katex.min.css';
export async function getStaticPaths() {
  const { writing } = await getSiteContent();
  return writing.map((entry, index) => ({ params: { slug: entry.id }, props: {
    entry, newer: writing[index - 1], older: writing[index + 1],
  } }));
}
interface Props { entry: CollectionEntry<'writing'>; newer?: CollectionEntry<'writing'>; older?: CollectionEntry<'writing'>; }
const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<Base title={entry.data.title} description={entry.data.description} article published={entry.data.published} updated={entry.data.updated}>
  <a class="back-link meta" href="/writing/">← All writing</a>
  <article>
    <PageHeader title={entry.data.title} eyebrow={entry.data.type.replace('-', ' ')} description={entry.data.description}>
      <p class="meta"><time datetime={entry.data.published!.toISOString()}>{formatDate(entry.data.published!)}</time> · {readingTime(entry.body)} min read</p>
      {entry.data.updated && <p class="meta">Last updated <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time></p>}
      {entry.data.tags.length > 0 && <ul class="tags" aria-label="Topics">{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </PageHeader>
    {toc.length > 0 && <nav class="toc" aria-label="Table of contents">
      <p class="eyebrow">In this piece</p>
      <ul>{toc.map((heading) => <li class:list={{ 'toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
    </nav>}
    <div class="prose"><Content /></div>
  </article>
  <Related entry={entry} />
  {(older || newer) && <nav class="article-pagination" aria-label="More writing">
    {older && <a href={`/writing/${older.id}/`}><span class="meta">← Previous</span>{older.data.title}</a>}
    {newer && <a href={`/writing/${newer.id}/`}><span class="meta">Next →</span>{newer.data.title}</a>}
  </nav>}
</Base>
