---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkList from '../../components/WorkList.astro';
import { getSiteContent } from '../../lib/content';
const { work } = await getSiteContent();
---
<Base title="Work" description="Selected engineering and research projects in computer vision, heterogeneous inference, and forecasting.">
  <PageHeader title="Work" eyebrow="Things I’m building" description="Runtimes, experiments, and the systems underneath. A few projects that have shaped how I think about software." />
  <WorkList entries={work} headingLevel="h2" />
</Base>
