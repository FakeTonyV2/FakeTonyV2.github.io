---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Related from '../../components/Related.astro';
import { getSiteContent } from '../../lib/content';
import { formatDate } from '../../config/site';
export async function getStaticPaths() {
  const { work } = await getSiteContent();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'work'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <a class="back-link meta" href="/work/">← All work</a>
  <PageHeader title={entry.data.title} eyebrow={entry.data.status} description={entry.data.summary}>
    {entry.data.startDate && <p class="meta">{formatDate(entry.data.startDate)}{entry.data.endDate && ` — ${formatDate(entry.data.endDate)}`}</p>}
    {entry.data.tags.length > 0 && <ul class="tags" aria-label="Topics">{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    {(entry.data.github || entry.data.external) && <div class="project-links">
      {entry.data.github && <a href={entry.data.github}>Repository ↗</a>}
      {entry.data.external && <a href={entry.data.external}>Project website ↗</a>}
    </div>}
  </PageHeader>
  {entry.data.cover && <Image class="project-cover" src={entry.data.cover} alt={entry.data.coverAlt!} layout="constrained" />}
  <div class="prose"><Content /></div>
  <Related entry={entry} />
</Base>
