---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import WritingList from '../components/WritingList.astro';
import { getSiteContent } from '../lib/content';
import { contacts, formatDate } from '../config/site';

const home = await getEntry('pages', 'home');
if (!home || !home.data.updated) throw new Error('The home page needs content and an updated date.');
const { Content } = await render(home);
const { writing } = await getSiteContent();
---
<Base description={home.data.description}>
  <article class="home prose">
    <h1>{home.data.title}</h1>
    <p class="meta home-updated">Last updated: <time datetime={home.data.updated.toISOString().slice(0, 10)}>{formatDate(home.data.updated).replace(/ \d{1,2},/, '')}</time></p>
    <Content />

    <section aria-labelledby="writing-heading">
      <h2 id="writing-heading">Writing</h2>
      <WritingList entries={writing.slice(0, 5)} headingLevel="h3" />
      {writing.length > 5 && <p><a href="/writing/">See all writing</a></p>}
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <p>I’m pretty easy to reach.</p>
      <ul class="plain-links">
        {contacts.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>
  </article>
</Base>
