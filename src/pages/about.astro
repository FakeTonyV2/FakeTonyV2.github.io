---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { contacts } from '../config/site';
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing about content.');
const { Content } = await render(entry);
---
<Base title="About" description={entry.data.description}>
  <PageHeader title={entry.data.title} />
  <div class="prose"><Content /></div>
  <section class="contact-section" aria-labelledby="about-contact"><h2 id="about-contact">Get in touch</h2>
    <ul class="contact-links">{contacts.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
  </section>
</Base>
