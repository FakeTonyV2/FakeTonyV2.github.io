---
import { site, navigation, contacts } from '../config/site';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const { title, description = site.description, article = false, published, updated, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.shortName}` : `${site.name} — systems & software`;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, site.origin).href;
const socialImage = new URL('/social.png', site.origin).href;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101216" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.shortName}’s writing`} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={`${site.shortName}’s notebook`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fiyin’s notebook — systems, software & other curiosities" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Fiyin — home">f<span aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation">
          {navigation.map(({ label, href }) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="footer-top">
          <p class="footer-signature">A corner of the internet.<br /><span>Always a work in progress.</span></p>
          <a class="back-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
        </div>
        <nav aria-label="Elsewhere">
          <a href="/reading/">Reading</a>
          <a href="/rss.xml">RSS</a>
          {contacts.map(({ label, href }) => <a href={href}>{label}</a>)}
        </nav>
        <p class="colophon">© {site.updated.slice(0, 4)} {site.name}</p>
      </footer>
    </div>
  </body>
</html>
